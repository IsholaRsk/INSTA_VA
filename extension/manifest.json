{
  "manifest_version": 3,
  "name": "Agent visuel local — cibles et redirections",
  "version": "0.9.0",
  "description": "Ouvre des URL, clique le lien indiqué (ou le lien principal) et répète selon le mode intervalle ou objectif, avec une liste de proxys Webshare en rotation.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "proxy",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Ouvrir l'agent visuel local"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/worker.min.js",
        "vendor/tesseract-core-*.wasm.js",
        "vendor/tesseract-core-*.wasm",
        "vendor/lang-data/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
