[Unit]
Description=Bot InstaVA (exécution Playwright + PWA de contrôle)
Documentation=https://github.com/IsholaRsk/INSTA_VA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=instava
Group=instava
WorkingDirectory=/opt/instava
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/var/lib/instava
EnvironmentFile=-/etc/instava/instava.env
ExecStart=/usr/bin/node /opt/instava/server/index.js
Restart=always
RestartSec=5
# Arrêt propre : le SIGTERM ferme Chromium et la base.
KillSignal=SIGTERM
TimeoutStopSec=30

# Durcissement : le service ne peut écrire que dans ses données et /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/instava
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
# Chromium a besoin de créer des processus enfants.
RestrictNamespaces=false

# Journalisation vers journald (aucun secret dans les logs).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=instava

[Install]
WantedBy=multi-user.target
