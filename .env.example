# Configuration du bot InstaVA sur VPS.
# Copier en .env (Docker) ou /etc/instava/instava.env (systemd), puis compléter.
# Ne jamais committer ce fichier rempli : .env est déjà ignoré par Git.

# ---------------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------------
# Port interne du serveur Node. En Docker, ne pas changer (Caddy proxifie bot:8080).
PORT=8080
# 0.0.0.0 dans Docker (réseau interne), 127.0.0.1 derrière Caddy installé sur l'hôte.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Domaine et HTTPS (Docker + Caddy)
# ---------------------------------------------------------------------------
# Domaine qui pointe (enregistrement A) vers l'IP du VPS.
INSTAVA_DOMAIN=bot.mondomaine.fr
# Courriel pour Let's Encrypt (facultatif, recommandé).
INSTAVA_EMAIL=moi@mondomaine.fr

# ---------------------------------------------------------------------------
# Données
# ---------------------------------------------------------------------------
# Dossier de la base SQLite et de la clé de chiffrement (data/secret.key).
DATA_DIR=./data
# Fuseau des quotas quotidiens (100 clics/jour). Cotonou = UTC+1 toute l'année.
INSTAVA_TZ=Africa/Porto-Novo

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Clé de chiffrement des identifiants proxy (AES-256-GCM).
# Laisser vide : le serveur en génère une au premier démarrage dans DATA_DIR/secret.key.
# Si vous la définissez : gardez la même valeur, sinon les proxys déjà enregistrés
# deviennent illisibles. Sauvegardez-la avec la base.
# Laisser vide = génération automatique dans DATA_DIR/secret.key (recommandé).
INSTAVA_SECRET_KEY=

# Durée de validité d'une session de connexion (jours).
INSTAVA_SESSION_DAYS=30
# Cookies Secure : true derrière HTTPS (défaut), false seulement en test local.
INSTAVA_SECURE_COOKIES=true
# Création de comptes après le premier propriétaire.
INSTAVA_ALLOW_SIGNUP=true
# Code d'invitation exigé pour toute nouvelle inscription (recommandé si signup ouvert).
INSTAVA_SIGNUP_CODE=

# ---------------------------------------------------------------------------
# Moteur d'exécution
# ---------------------------------------------------------------------------
# Vérification des visites dues (millisecondes).
INSTAVA_TICK_MS=5000
# Cycles Playwright simultanés (2 suffit pour ~288 clics/jour par cible).
INSTAVA_CONCURRENCY=2
# Délai maximal de chargement d'une page.
INSTAVA_NAVIGATION_TIMEOUT_MS=45000
# Navigateur sans interface (toujours true sur un VPS sans écran).
INSTAVA_HEADLESS=true
# Chemin d'un Chromium donné ; vide = Chromium installé par Playwright.
# En Docker, laisser vide : l'image définit CHROMIUM_PATH=/usr/bin/chromium.
CHROMIUM_PATH=

# Journalisation : debug | info | warn | error
INSTAVA_LOG_LEVEL=info
